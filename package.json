{
  "name": "psst-link",
  "version": "0.1.0",
  "description": "Ask a person for a secret through a one-time link. It's encrypted in their browser, and only your agent can open it.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "psst": "dist/psst.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/page.ts && convex dev",
    "deploy": "node scripts/page.ts && convex deploy",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/psst.js",
    "prepack": "npm run build",
    "check": "node scripts/page.ts && tsc -p . && node --test 'test/*.test.ts'"
  },
  "devDependencies": {
    "@convex-dev/rate-limiter": "^0.4.1",
    "@types/node": "^24.0.0",
    "convex": "^1.46.0",
    "esbuild": "0.27.0",
    "typescript": "^7.0.2"
  }
}
