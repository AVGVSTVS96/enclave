{
  "name": "enclave-link",
  "version": "0.2.13",
  "description": "Your agent asks for a password by one-time link, not in chat, and uses it without seeing it.",
  "license": "MIT",
  "bin": {
    "enclave": "dist/enclave.js"
  },
  "workspaces": {
    "packages": [
      "site",
      "brand"
    ],
    "catalog": {
      "typescript": "7.0.2"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node scripts/page.ts && convex dev",
    "deploy": "node scripts/page.ts && convex deploy",
    "build": "node scripts/build.ts",
    "prepack": "node scripts/build.ts",
    "check": "node scripts/page.ts && oxlint && oxfmt --check && tsc -p . && bun --filter enclave-site typecheck && node --test \"test/*.test.ts\"",
    "fix": "oxlint --fix; oxfmt",
    "prepare": "lefthook install",
    "version": "node scripts/version.ts"
  },
  "devDependencies": {
    "@convex-dev/rate-limiter": "0.4.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@msgpack/msgpack": "3.1.3",
    "@oxlint/plugins": "1.91.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "convex": "1.49.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "catalog:",
    "ultracite": "8.1.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.3",
  "mcpName": "io.github.AVGVSTVS96/enclave"
}
