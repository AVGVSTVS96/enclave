{
  "name": "enclave-link",
  "version": "0.2.13",
  "description": "Your agent asks for a password by one-time link, not in chat, and uses it without seeing it.",
  "license": "MIT",
  "bin": {
    "enclave": "dist/enclave.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "node scripts/page.ts && convex dev",
    "deploy": "node scripts/page.ts && convex deploy",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "check": "node scripts/page.ts && tsc -p . && oxlint && oxfmt --check && node --test 'test/*.test.ts'",
    "format": "oxfmt && oxlint --fix",
    "version": "node scripts/version.ts"
  },
  "devDependencies": {
    "@convex-dev/rate-limiter": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@msgpack/msgpack": "^3.1.3",
    "@oxlint/plugins": "^1.90.0",
    "@types/node": "^24.0.0",
    "convex": "^1.46.0",
    "esbuild": "0.27.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "mcpName": "io.github.AVGVSTVS96/enclave"
}
