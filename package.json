{
  "name": "enclave-link",
  "version": "0.1.0",
  "description": "Ask a person for a secret through a one-time link. It's encrypted in their browser, and only your agent can open it.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/types/index.d.ts",
  "bin": {
    "enclave": "dist/enclave.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/page.ts && convex dev",
    "deploy": "node scripts/page.ts && convex deploy",
    "build": "node scripts/build.ts",
    "prepack": "npm run build",
    "check": "node scripts/page.ts && tsc -p . && node --test 'test/*.test.ts'"
  },
  "devDependencies": {
    "@convex-dev/rate-limiter": "^0.4.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.0.0",
    "convex": "^1.46.0",
    "esbuild": "0.27.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "mcpName": "io.github.avgvstvs96/enclave"
}
